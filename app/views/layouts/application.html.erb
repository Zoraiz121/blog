<!DOCTYPE html>
<html>
  <head>
    <title>Blog</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

<%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "professional_buttons", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "musing", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "musing_navbar", "data-turbo-track": "reload" %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>

  <body>
   <nav class="musing-navbar">
  <div class="container musing-navbar-inner">

    <!-- Brand -->
    <%= link_to root_path, class: "musing-navbar-brand" do %>
      THE CONTENT<span>HUB.</span>
    <% end %>

    <!-- Mobile menu toggle -->
    <button
      class="musing-nav-toggle"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#musingNavbar"
      aria-controls="musingNavbar"
      aria-expanded="false"
      aria-label="Toggle navigation">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- Navigation -->
    <div class="collapse musing-navbar-menu" id="musingNavbar">

      <div class="musing-navbar-links">
        <%= link_to "Home", root_path, class: "musing-nav-link" %>
        <%= link_to "Articles", articles_path, class: "musing-nav-link" %>
      </div>

      <div class="musing-navbar-actions">
        <% if user_signed_in? %>

          <%= link_to new_article_path, class: "musing-nav-write" do %>
            <span>＋</span> WRITE A STORY
          <% end %>

          <div class="musing-nav-account">
            <span class="musing-nav-avatar">
              <%= current_user.email.first.upcase %>
            </span>

            <span class="musing-nav-email">
              <%= current_user.email %>
            </span>
          </div>

          <%= button_to "SIGN OUT",
              destroy_user_session_path,
              method: :delete,
              class: "musing-nav-signout" %>

        <% else %>

          <%= link_to "SIGN IN",
              new_user_session_path,
              class: "musing-nav-signin" %>

          <%= link_to "GET STARTED",
              new_user_registration_path,
              class: "musing-nav-write" %>

        <% end %>
      </div>

    </div>
  </div>
</nav>

    <%= render "shared/flash" %>

    <main>
      <%= yield %>
    </main>

    <footer class="border-top mt-5 py-4 bg-white">
      <div class="container text-center text-muted small">
        © <%= Date.current.year %> Rails Blog. Built with Ruby on Rails.
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>