
<section class="musing-hero">
  <div class="container">
    <div class="musing-hero-inner">
      <p class="musing-eyebrow">THE CONTENT HUB · AN EDITORIAL SPACE</p>

      <h1>Stories that <em>stay with you.</em></h1>

      <p class="musing-hero-description">
        A collection of thoughtful perspectives, fresh ideas,
        and stories worth sharing.
      </p>

      <a href="#latest-stories" class="musing-text-link">
        EXPLORE THE JOURNAL <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<% if @articles.any? && params[:query].blank? %>
  <% featured = @articles.first %>

  <section class="musing-featured">
    <div class="container">
      <div class="musing-section-heading">
        <span>01 / EDITOR'S PICK</span>
        <span>FEATURED STORY</span>
      </div>

      <div class="row g-0 align-items-center musing-featured-grid">
        <div class="col-lg-7">
          <%= link_to article_path(featured),
              class: "musing-featured-image-link" do %>
            <% if featured.cover_image.attached? %>
              <%= image_tag featured.cover_image,
                  class: "musing-featured-image",
                  alt: featured.title %>
            <% elsif featured.image.attached? %>
              <%= image_tag featured.image,
                  class: "musing-featured-image",
                  alt: featured.title %>
            <% else %>
              <div class="musing-image-placeholder">
                <span>THE CONTENT HUB</span>
              </div>
            <% end %>
          <% end %>
        </div>

        <div class="col-lg-5">
          <div class="musing-featured-content">
            <p class="musing-eyebrow">
              <%= featured.category.presence || "EDITORIAL" %>
              · <%= featured.created_at.strftime("%B %d, %Y") %>
            </p>

            <h2>
              <%= link_to featured.title, article_path(featured) %>
            </h2>

            <p class="musing-featured-excerpt">
              <%= truncate(strip_tags(featured.body.to_s),
                  length: 190) %>
            </p>

            <%= link_to "READ THE STORY ↗",
                article_path(featured),
                class: "musing-text-link" %>
          </div>
        </div>
      </div>
    </div>
  </section>
<% end %>

<section class="musing-journal" id="latest-stories">
  <div class="container">
    <div class="musing-journal-header">
      <div>
        <p class="musing-eyebrow">THE JOURNAL</p>
        <h2>
          <%= params[:query].present? ? "Search results" : "Latest stories" %>
        </h2>
      </div>

      <% if user_signed_in? %>
        <%= link_to "WRITE A STORY ↗",
            new_article_path,
            class: "musing-text-link" %>
      <% end %>
    </div>

    <div class="musing-search">
      <%= form_with url: articles_path,
          method: :get,
          local: true,
          class: "musing-search-form" do |f| %>

        <%= f.search_field :query,
            value: params[:query],
            placeholder: "Search stories...",
            aria: { label: "Search stories" },
            class: "musing-search-input" %>

        <%= f.submit "SEARCH",
            class: "musing-search-button" %>

        <% if params[:query].present? %>
          <%= link_to "CLEAR",
              articles_path,
              class: "musing-search-clear" %>
        <% end %>
      <% end %>
    </div>

    <% if @articles.empty? %>
      <div class="musing-empty">
        <h3>No stories found.</h3>
        <p>
          <%= params[:query].present? ?
              "Try a different search." :
              "The first story is waiting to be written." %>
        </p>

        <% if user_signed_in? %>
          <%= link_to "WRITE A STORY",
              new_article_path,
              class: "musing-primary-button" %>
        <% end %>
      </div>
    <% else %>
      <div class="row g-5">
        <% @articles.each do |article| %>
          <div class="col-md-6 col-lg-4">
            <article class="musing-article-card">
              <%= link_to article_path(article),
                  class: "musing-card-image-link" do %>

                <% if article.cover_image.attached? %>
                  <%= image_tag article.cover_image,
                      class: "musing-card-image",
                      alt: article.title,
                      loading: "lazy" %>
                <% elsif article.image.attached? %>
                  <%= image_tag article.image,
                      class: "musing-card-image",
                      alt: article.title,
                      loading: "lazy" %>
                <% else %>
                  <div class="musing-card-placeholder">
                    <span>THE CONTENT HUB</span>
                  </div>
                <% end %>
              <% end %>

              <div class="musing-card-content">
                <p class="musing-card-category">
                  <%= article.category.presence || "STORIES" %>
                  <span>·</span>
                  <%= article.created_at.strftime("%b %d, %Y") %>
                </p>

                <h3>
                  <%= link_to article.title,
                      article_path(article) %>
                </h3>

                <p class="musing-card-excerpt">
                  <%= truncate(strip_tags(article.body.to_s),
                      length: 125) %>
                </p>

                <div class="musing-card-bottom">
                  <%= link_to "READ MORE ↗",
                      article_path(article),
                      class: "musing-text-link" %>

                  <span>
                    <%= pluralize(article.comments_count, "comment") %>
                  </span>
                </div>

                <% if user_signed_in? &&
                      article.user_id == current_user.id %>
                  <div class="musing-owner-actions">
                    <%= link_to "Edit",
                        edit_article_path(article),
                        class: "musing-edit-link" %>

                    <%= button_to "Delete",
                        article_path(article),
                        method: :delete,
                        data: {
                          turbo_confirm: "Delete this story?"
                        },
                        class: "musing-delete-button" %>
                  </div>
                <% end %>
              </div>
            </article>
          </div>
        <% end %>
      </div>

      <% if defined?(@pagy) && @pagy %>
        <div class="musing-pagination">
          <%= render "shared/pagination", pagy: @pagy %>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
