
<div class="musing-editor-shell">
  <%= form_with model: article, local: true,
      html: { multipart: true } do |f| %>

    <% if article.errors.any? %>
      <div class="alert alert-danger" role="alert">
        <strong>Please review your story:</strong>
        <ul class="mb-0 mt-2">
          <% article.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="musing-editor-section">
      <p class="musing-editor-step">01 / THE HEADLINE</p>
      <%= f.label :title, "Story title",
          class: "musing-editor-label" %>

      <%= f.text_field :title,
          class: "musing-title-input",
          placeholder: "Give your story a beautiful title...",
          required: true %>
    </div>

    <div class="musing-editor-section">
      <p class="musing-editor-step">02 / THE STORY</p>
      <%= f.label :body, "Your story",
          class: "musing-editor-label" %>

      <%= f.text_area :body,
          rows: 14,
          class: "musing-body-input",
          placeholder: "Once upon a time, an idea began...",
          required: true,
          minlength: 10 %>

      <p class="musing-editor-hint">
        Let your ideas flow. You can always refine them later.
      </p>
    </div>

    <div class="musing-editor-section">
      <p class="musing-editor-step">03 / STORY DETAILS</p>

      <div class="row g-4">
        <div class="col-md-6">
          <%= f.label :category, "Category",
              class: "musing-editor-label" %>

          <%= f.select :category,
              ["Technology", "Ruby on Rails",
               "Programming", "AI", "General"],
              { prompt: "Choose a category" },
              class: "musing-editor-select" %>
        </div>

        <div class="col-md-6">
          <%= f.label :status, "Publishing status",
              class: "musing-editor-label" %>

          <%= f.select :status,
              [["Published", "published"],
               ["Draft", "draft"],
               ["Archived", "archived"]],
              {},
              class: "musing-editor-select" %>
        </div>
      </div>
    </div>

    <div class="musing-editor-section">
      <p class="musing-editor-step">04 / COVER IMAGE</p>

      <%= f.label :cover_image, "Story cover",
          class: "musing-editor-label" %>

      <div class="musing-upload-area">
        <div class="musing-upload-icon" aria-hidden="true">↥</div>
        <p>Choose a beautiful image for your story</p>
        <span>Recommended: landscape JPG, PNG or WebP</span>

        <%= f.file_field :cover_image,
            accept: "image/jpeg,image/png,image/webp",
            class: "musing-file-input" %>
      </div>

      <% if article.cover_image.attached? %>
        <div class="musing-current-cover">
          <p>Current cover image</p>
          <%= image_tag article.cover_image,
              alt: "Current cover image" %>
        </div>
      <% elsif article.image.attached? %>
        <div class="musing-current-cover">
          <p>Current article image</p>
          <%= image_tag article.image,
              alt: "Current article image" %>
        </div>
      <% end %>
    </div>

    <div class="musing-editor-actions">
      <%= link_to "← BACK TO STORIES",
          articles_path,
          class: "musing-editor-cancel" %>

      <%= f.submit(
          article.persisted? ? "UPDATE STORY ↗" : "PUBLISH STORY ↗",
          class: "musing-editor-submit"
      ) %>
    </div>
  <% end %>
</div>
